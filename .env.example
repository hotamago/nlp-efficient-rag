# Copy to .env (never commit .env).

# Generator LLM: any OpenAI-compatible endpoint (cloud API, vLLM, Ollama, LM Studio...).
# The WHOLE team must use the same LLM_MODEL for every run reported in the paper.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# USD per 1M input tokens, only for cost estimates in summary.csv
LLM_PRICE_IN=0.02

# Local examples:
# LLM_BASE_URL=http://localhost:8000/v1   # vLLM
# LLM_BASE_URL=http://localhost:11434/v1  # Ollama

# Hugging Face cache on a disk with space (models take ~10 GB)
# HF_HOME=/mnt/d/WSL_Storage/huggingface
# HF_TOKEN=hf_xxx   # only for gated models (EmbeddingGemma, Gemma)

# Force device for compressors/retrievers: cuda | cpu
# EFFRAG_DEVICE=cuda
